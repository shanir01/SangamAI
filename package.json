{
  "name": "sangamai",
  "version": "2.1.0",
  "description": "SangamAI: all free AI APIs, one endpoint. One OpenAI-compatible API on localhost over free Gemini, Groq, OpenRouter and Mistral keys, with auto-fallback, round-robin, usage dashboard and a web Setup page. Runs on Windows, Mac, Linux and Android (Termux). Zero dependencies.",
  "main": "src/server.js",
  "bin": {
    "sangamai": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "demo": "node examples/demo-mock.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "sangamai",
    "free-llm",
    "llm-router",
    "openai-compatible",
    "llm-gateway",
    "free-ai",
    "ai-api",
    "gemini",
    "groq",
    "openrouter",
    "mistral",
    "termux",
    "localhost",
    "self-hosted",
    "failover"
  ],
  "author": "Nirbhay Sharma (NISHU)",
