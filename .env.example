# ===== FreeLLM Router settings (OPTIONAL) =====
# For normal use on your own computer you do NOT need this file: just run start.bat /
# ./start.sh and paste your keys on the Setup page in the browser.
# Use .env if you prefer files, or for server mode. Copy it to ".env". NEVER upload .env to
# GitHub (it is already in .gitignore). Any subset of provider keys works.

# --- Protection (optional on localhost, REQUIRED when the server is on the internet) ---
# Your own secret key for YOUR apps. Make it long & random, e.g. sk-mine-8f3k2l9x...
MASTER_KEY=
# Password for the admin dashboard (http://your-server/). If empty, MASTER_KEY is used.
ADMIN_PASSWORD=

# --- Free provider keys (get them from the links in README) ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys  (only ":free" models are used)
OPENROUTER_API_KEY=
# Mistral: https://console.mistral.ai/api-keys  (choose the free plan)
MISTRAL_API_KEY=
# Cerebras (trial credits only, expire after 30 days): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Hugging Face (needs PRO or paid credits; off by default in router.config.json): https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Server mode (ADVANCED): other people use your router with their own sk-flr- keys ---
SERVER_MODE=false
# Daily token limit for each new user key
DEFAULT_USER_QUOTA=50000
# Public signup page at /signup (anyone can get a key). Keep false unless you want it.
ENABLE_SIGNUP=false
# Maximum number of user keys
MAX_USERS=200

# --- Cloud save (for Render free, which forgets files when it sleeps) ---
# Keeps users.json + usage counters in a PRIVATE GitHub Gist. Create a secret gist at
# https://gist.github.com (any file, e.g. readme.txt), copy its ID from the URL, and a token at
# https://github.com/settings/tokens (classic token, only the "gist" box ticked).
GIST_ID=
GITHUB_TOKEN=

# --- Server (normally leave these empty) ---
# PORT=8787
# HOST=127.0.0.1        (use 0.0.0.0 to open it to your Wi-Fi; needs MASTER_KEY)
# STATE_FILE=router.state.json
# USERS_FILE=users.json
